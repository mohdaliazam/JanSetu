{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JanSetuGroupExportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "provider_mode", "group_id", "locality_id", "category", "report_ids", "indicator_ids", "plan_ids", "source_ids", "score", "formula_version", "exported_at", "evidence_packet"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "synthetic": {"type": "boolean"},
    "provider_mode": {"enum": ["live", "fixture"]},
    "group_id": {"type": "string", "minLength": 1},
    "locality_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["water", "roads", "sanitation", "lighting", "education", "healthcare_access", "other"]},
    "report_ids": {"type": "array", "items": {"type": "string"}},
    "indicator_ids": {"type": "array", "items": {"type": "string"}},
    "plan_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "formula_version": {"const": "v1"},
    "exported_at": {"type": "string", "format": "date-time"},
    "evidence_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality", "indicators", "plans", "reports", "sources"],
      "properties": {
        "locality": {"type": "object", "required": ["id", "name", "state_code", "district_id", "synthetic"]},
        "indicators": {"type": "array", "items": {"type": "object", "required": ["id", "locality_id", "category", "population", "gap_pct", "source_id", "as_of"]}},
        "plans": {"type": "array", "items": {"type": "object", "required": ["id", "locality_id", "category", "status", "source_id", "as_of"]}},
        "reports": {"type": "array", "items": {"type": "object", "required": ["id", "redacted_text", "provider_mode"]}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "title", "as_of", "caveat"]}}
      }
    }
  }
}
